{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "resolveJsonModule": true,
    "types": ["node", "vite/client", "vitest/globals", "@testing-library/jest-dom"],
    "paths": {
      "modules": ["./src/modules"],
      "modules/*": ["./src/modules/*"],
      "shared": ["./src/shared"],
      "shared/*": ["./src/shared/*"],
      "routes": ["./src/routes"],
      "routes/*": ["./src/routes/*"]
    }
  },
  "include": ["src", "e2e", "*.ts"]
}
