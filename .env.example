RUNWARE_API_KEY=your-runware-key
BETTER_AUTH_SECRET=generate-a-32-char-random-string
# In production BETTER_AUTH_URL MUST be the public https origin of the
# deployment (e.g. https://app.example.com) — session cookies, OAuth callbacks
# and the CSRF origin check all derive from it.
BETTER_AUTH_URL=http://localhost:8787
WEB_ORIGIN=http://localhost:5173
API_PORT=8787
DATABASE_PATH=./data/opencreate.db
STORAGE_DIR=./data/media
SIGNUP_BONUS_CREDITS=200
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# pino log level: fatal|error|warn|info|debug|trace|silent (default info)
LOG_LEVEL=info
# NODE_ENV=production enables single-origin serving of the built SPA (see
# WEB_DIST_PATH) and is set automatically by `pnpm start` — no need to set it
# here for local development.
# Comma-separated origins allowed to make cookie-carrying auth requests
# (better-auth CSRF allowlist). Defaults to WEB_ORIGIN when empty.
TRUSTED_ORIGINS=
# Where the built SPA lives; relative paths resolve against apps/api.
WEB_DIST_PATH=../web/dist
# SSRF allowlist for provider asset downloads: comma-separated host suffixes
# storage.saveFromUrl may fetch from (exact domain or true subdomains).
# Default locks downloads to Runware's own domain — widen only for a verified
# provider/CDN change.
ASSET_HOST_ALLOWLIST=runware.ai
# Optional: explicit .env file for the native loader (defaults to the nearest
# .env walking up from the working directory).
# ENV_FILE=
# Reverse-proxy header trust for rate-limit attribution. Leave unset when the
# API is exposed directly (a client-forged X-Forwarded-For must be ignored).
# Behind the PROD.md reverse proxy set `true` (the proxy must OVERWRITE the
# inbound X-Forwarded-For, e.g. nginx $remote_addr) or, safer, a comma list of
# trusted peer addresses/CIDRs/keywords, e.g. `loopback,uniquelocal`.
# TRUST_PROXY=
# Asset download hardening (defaults shown)
ASSET_FETCH_TIMEOUT_MS=120000
ASSET_MAX_BYTES=536870912
# Self-hosted Wan 2.2 video provider (wan-runpod). Base URL of the pod's ComfyUI
# HTTP API, e.g. https://<podid>-8188.proxy.runpod.net (no trailing slash). When
# set, the wan-2-2 ("Forge") model routes submit/poll to ComfyUI and this host is
# auto-added to ASSET_HOST_ALLOWLIST so the finished mp4 (/view) can be downloaded.
# Leave UNSET to keep the model listed but return a clean provider_error on submit
# (boot never fails on a missing pod).
# COMFY_BASE_URL=https://<podid>-8188.proxy.runpod.net
# Direct ByteDance ModelArk channel (optional) — Seedance 2.0 WITHOUT the Runware
# aggregator in the path. A plain bearer token from the BytePlus console
# (ModelArk → API keys, region ap-southeast-1: Seedance is served ONLY from there).
# When set, the seedance-2-0 ("Auteur") model appears in /api/catalog and routes
# submit/poll straight to ByteDance; ByteDance's asset host is auto-added to
# ASSET_HOST_ALLOWLIST so the finished mp4 can be copied into our storage before
# ByteDance HARD-DELETES it at 24h. Leave UNSET to hide the model entirely (boot
# stays healthy). Billing is pay-as-you-go by token — a prepaid resource pack is
# optional, not required.
# ARK_API_KEY=
# CinemaStudio script→storyboard (optional). Anthropic API key used ONLY by the
# POST /api/films/:id/storyboard endpoint (Claude breaks a script into draft
# shots). Leave UNSET to keep boot healthy — that endpoint then returns a clean
# provider_error; every other CinemaStudio feature (timeline, render, generate)
# works without it.
# ANTHROPIC_API_KEY=sk-ant-...
# Prompt enhancer fallback LLM (optional, FREE). POST /api/prompt/enhance runs an
# ordered provider chain: DeepInfra (DeepSeek-V3, set via DEEPINFRA_TOKEN) first, then
# Groq (llama-3.3-70b) as a free fallback when DeepInfra is absent or out of balance.
# EITHER key alone makes the endpoint work; with NEITHER it returns a clean
# provider_error (boot stays healthy). Get a free key at https://console.groq.com.
# GROQ_API_KEY=
