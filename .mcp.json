{
  "mcpServers": {
    "claude-flow": {
      "command": "npx",
      "args": [
        "-y",
        "ruflo@latest",
        "mcp",
        "start"
      ],
      "env": {
        "npm_config_update_notifier": "false",
        "CLAUDE_FLOW_MODE": "v3",
        "CLAUDE_FLOW_HOOKS_ENABLED": "true",
        "CLAUDE_FLOW_TOPOLOGY": "hierarchical-mesh",
        "CLAUDE_FLOW_MAX_AGENTS": "15",
        "CLAUDE_FLOW_MEMORY_BACKEND": "hybrid"
      },
      "autoStart": false
    },
    "opencreate": {
      "command": "npx",
      "args": ["tsx", "packages/mcp/src/index.ts"],
      "env": {
        "OPENCREATE_BASE_URL": "${OPENCREATE_BASE_URL:-http://localhost:8787}",
        "OPENCREATE_EMAIL": "${OPENCREATE_EMAIL}",
        "OPENCREATE_PASSWORD": "${OPENCREATE_PASSWORD}"
      },
      "autoStart": false
    }
  }
}