{
  "name": "@opencreate/mcp",
  "version": "0.0.1",
  "type": "module",
  "description": "MCP server that wraps the openCreate REST API so a Claude user can create content and whole film projects from Claude Desktop/Code.",
  "main": "./src/lib.ts",
  "types": "./src/lib.ts",
  "exports": {
    ".": "./src/lib.ts"
  },
  "bin": {
    "opencreate-mcp": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opencreate/contracts": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "eslint": "^10.6.0",
    "prettier": "^3.9.4",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  }
}
