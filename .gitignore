# ============================================================================
#  Distribution .gitignore — keep the toolkit payload, drop runtime & secrets
# ============================================================================

# --- Secrets / local-only ---------------------------------------------------
.env
.env.local
.env.*.local
CLAUDE.local.md
.claude/settings.local.json

# --- Runtime state & generated data (NOT distributed) -----------------------
# Patterns match at ANY depth (covers nested bundles like frontend-agents/).
*.db
*.db-*
*.rvf
*.rvf.lock
**/.swarm/
**/.claude-flow/data/
**/.claude-flow/logs/
**/.claude/memory/
*.log
.DS_Store

# --- Locally-fetched npm package (re-fetched via `npx -y ruflo@latest`) ------
ruflo/

# --- Pre-ruflo backups ------------------------------------------------------
CLAUDE.md.pre-ruflo
*.bak

# --- Node -------------------------------------------------------------------
node_modules/

# NOTE: .codex/ IS shipped (config.toml + AGENTS.override.md are shareable).
# Codex local session data, if any, should be added explicitly below.

# .ai canonical runtime (через симлинки .claude/.codex)
.ai/memory.db
.ai/memory.db-*
.ai/*.lock
.ai/checkpoints/
.ai/settings.local.json
ruvector.db

# --- Agent-runtime state (churns every session — never commit) ---------------
.claude-flow/
.swarm/
.rtk/
ruvector.db
memory.db

# --- openCreate workspace ----------------------------------------------------
# pnpm is the ONLY package manager here (root `packageManager` pins it, the
# Dockerfile and CI both install with --frozen-lockfile from pnpm-lock.yaml).
# An npm lockfile is always an accident and would give CI a second, divergent
# dependency graph to resolve from.
package-lock.json
node_modules/
dist/
data/
.env
*.tsbuildinfo
playwright-report/
test-results/

# --- Spike runtime outputs (feasibility spikes; never commit generated media) -
spikes/**/.env
spikes/**/out/
spikes/**/*.mp4
spikes/**/.venv/

# --- TanStack Router generated cache (build artifact, not source) -----------
apps/web/.tanstack/

# graphify knowledge-graph tool cache
graphify-out/
.superpowers/
