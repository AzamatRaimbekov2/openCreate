  "10": {
    "class_type": "KSamplerAdvanced",
    "inputs": {
      "model": ["7", 0],
      "positive": ["9", 0],
      "negative": ["9", 1],
      "latent_image": ["9", 2],
      "add_noise": "enable",
      "noise_seed": 0,
      "steps": 20,
      "cfg": 3.5,
      "sampler_name": "euler",
