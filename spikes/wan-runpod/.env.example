# ─────────────────────────────────────────────────────────────────────────────
# Wan 2.2 RunPod spike — measurement client env. Copy to `.env` and fill in.
#   cp .env.example .env  &&  set -a; source .env; set +a  &&  python measure/run.py
# NEVER commit .env — it is gitignored. Secrets live here only, never in code.
# ─────────────────────────────────────────────────────────────────────────────

# --- RunPod ------------------------------------------------------------------
RUNPOD_API_KEY=                       # RunPod → Settings → API Keys
RUNPOD_ENDPOINT_ID=                   # the 4090 serverless endpoint id (required)
# RUNPOD_ENDPOINT_ID_H100=            # optional: an H100 PCIe endpoint for the fallback test

# Real per-second rate shown on your endpoint's pricing. Default below is the ADR
# 4090 COMMUNITY rate; serverless FLEX is a premium (~1.3–1.8x) — SET THE REAL ONE
# or the $/clip gate reads optimistically.
# RUNPOD_GPU_RATE_PER_SEC_4090=0.0000944
# RUNPOD_GPU_RATE_PER_SEC_H100=0.000553

# --- Object store (AWS S3 or Cloudflare R2 — both S3-compatible via boto3) ----
# For R2: set S3_ENDPOINT_URL to https://<accountid>.r2.cloudflarestorage.com and S3_REGION=auto
# For AWS: leave S3_ENDPOINT_URL blank and set S3_REGION to the bucket region.
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional public base URL (custom domain / R2 public bucket) to print a shareable GET link.
# S3_PUBLIC_BASE_URL=https://media.example.com

# --- Prompt / clip params (defaults match the ADR Seedance reference) ---------
# SPIKE_PROMPT=A cinematic slow dolly-in on a lone astronaut on a red desert dune at golden hour...
# SPIKE_WIDTH=1280
# SPIKE_HEIGHT=720
# SPIKE_DURATION=5
# SPIKE_SEED=12345                     # keep fixed so the Wan/Seedance side-by-side is comparable

# --- i2v seed image (optional; omit to skip the i2v clip) ---------------------
# I2V_IMAGE_PATH=./assets/seed.png     # local file → sent as a data-uri (no public URL needed)
# I2V_IMAGE_URL=https://example.com/seed.png
